<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>neo_webapp</name>
  <version>0.1.0</version>
  <description>Neo admin panel: always-on light API plus an on-demand media bridge.</description>
  <maintainer email="funkydude450@gmail.com">Nekhal James</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <!-- neo_msgs is required only by the ROS bridge backend (Phase 1). -->
  <exec_depend>neo_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!--
    No per-package setup.py right now: pip installation is consolidated in the
    repo root's pyproject.toml (see ../../README.md) so there is exactly one
    way to install everything. build_type/setup.py comes back here once the
    ROS workspace / colcon build is actually wired up (plan Phase 0/1).
  -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
