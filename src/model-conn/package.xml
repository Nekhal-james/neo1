<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>model_conn</name>
  <version>0.1.0</version>
  <description>CLI for the off-board Qwen 2.5 host/receiver link: serves the model (host) and checks the link (receiver).</description>
  <maintainer email="funkydude450@gmail.com">Nekhal James</maintainer>
  <license>MIT</license>

  <!-- Only nodes/link_node.py needs these, and only once neo_msgs exists (Phase 1). -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>neo_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!--
    Per-package setup.py landed alongside the real node binding in
    model_conn/nodes/link_node.py (see ../../setup.py). No more COLCON_IGNORE:
    colcon build (base-paths src) now builds this package and ros2 run
    model_conn link_node can find it. Pip installation (everything that isn't
    ros2 run) still goes through the repo root's setup.py, per ../../README.md.
  -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
