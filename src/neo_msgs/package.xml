<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>neo_msgs</name>
  <version>0.1.0</version>
  <description>Frozen message and service contracts for Neo. Interfaces only -- no logic, no runtime dependencies.</description>
  <maintainer email="funkydude450@gmail.com">Nekhal James</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!--
    std_msgs only, for Header. Deliberately nothing else: neo_msgs is the leaf
    every other package depends on, so a dependency added here is a dependency
    added everywhere. Interfaces that need sensor_msgs/vision_msgs types
    (/head/state, /joy, /perception/detections) use those packages' own
    messages directly rather than wrapping them; see section 1.2 of the plan.
  -->
  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- No ament_lint_common: its linters enforce a house style this repo
       has decided against gating on. See CMakeLists.txt. -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
