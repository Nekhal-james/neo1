<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>neo_motion</name>
  <version>0.1.0</version>
  <description>Head arbitration and the servo driver: the only path to the servos.</description>
  <maintainer email="funkydude450@gmail.com">Nekhal James</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <!-- Required only by the ROS nodes; the core is pure Python. -->
  <exec_depend>neo_msgs</exec_depend>
  <!--
    Pca9685Backend writes the chip's registers over I2C with smbus2, imported
    lazily: the mock backend is what the tests and the admin panel run against,
    so this package installs and passes its suite on a machine with no I2C bus.
    Not Adafruit's CircuitPython driver, which cannot be imported on Ubuntu for
    the Pi without a GPIO library; see neo_motion/backend.py. (No double
    hyphens anywhere in an XML comment: one here made the whole file invalid,
    and rosdep, reading every package.xml under src/, stopped the Pi setup.)
  -->
  <exec_depend>python3-smbus2</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!--
    Per-package setup.py landed alongside the real node bindings in
    nodes/servo_driver.py and nodes/head_behavior.py (see ../../setup.py). No
    more COLCON_IGNORE: colcon build (base-paths src) now builds this package
    and ros2 run neo_motion {servo_driver,head_behavior} can find them.
  -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
