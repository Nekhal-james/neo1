<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>neo_motion</name>
  <version>0.1.0</version>
  <description>Head arbitration and the servo driver: the only path to the servos.</description>
  <maintainer email="funkydude450@gmail.com">Nekhal James</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <!-- Required only by the ROS nodes; the core is pure Python. -->
  <exec_depend>neo_msgs</exec_depend>
  <!--
    The PCA9685 driver is imported lazily by Pca9685Backend and is not a
    dependency of anything else here: the mock backend is what the tests and the
    admin panel run against, so this package installs and passes its suite on a
    machine with no I2C bus.
  -->
  <exec_depend>python3-adafruit-circuitpython-pca9685-pip</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- See ./COLCON_IGNORE for why there is no per-package setup.py yet. -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
