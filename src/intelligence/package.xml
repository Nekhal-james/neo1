<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>intelligence</name>
  <version>0.1.0</version>
  <description>Prompts, RAG data, and chat/ASR/TTS for the Neo assistant, reached via model_conn's link.</description>
  <maintainer email="funkydude450@gmail.com">Nekhal James</maintainer>
  <license>MIT</license>

  <!-- Only nodes/dialog_node.py needs these. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>neo_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <!-- chat.py calls into model_conn's link for the off-board host. -->
  <exec_depend>model_conn</exec_depend>

  <!-- test_vision_context.py monkeypatches neo_perception.status_store directly.
       Test-only: chat.py's own import of it stays lazy and optional at
       runtime (a missing camera process is not an error, see chat.py). -->
  <test_depend>neo_perception</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!--
    Per-package setup.py landed alongside the real node binding in
    intelligence/nodes/dialog_node.py (see ../../setup.py). No more
    COLCON_IGNORE: colcon build (base-paths src) now builds this package and
    ros2 run intelligence dialog_node can find it. Pip installation
    (everything that isn't ros2 run) still goes through the repo root's
    setup.py, per ../../README.md.
  -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
